//kage:unit pixels

package main

// Curved CRT: barrel distortion, rounded vignetted tube corners, scanlines and
// a slow rolling scan bar. The barrel formula must match state.Barrel in
// ui/state/barrel.go (it is what maps mouse clicks back to the scene).

var Curvature float
var Vignette float
var ScanlineStrength float
var ScanBarStrength float
var ScanBarPeriod float
var Time float
var ScanBar float // 0 or 1
var Size vec2
var BG vec4

func Fragment(dst vec4, src vec2, color vec4) vec4 {
	p := dst.xy
	u := 2.0*p/Size - vec2(1.0)
	f := 1.0 + Curvature*dot(u, u)
	s := (u*f + vec2(1.0)) * Size / 2.0

	// Tube corner mask: rounded box signed distance, 2px soft edge.
	r := Curvature * 0.5 * min(Size.x, Size.y)
	q := abs(p-Size/2.0) - (Size/2.0 - vec2(r))
	d := length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - r
	mask := 1.0 - smoothstep(-1.0, 1.0, d)

	var c vec4
	if s.x < 0.0 || s.y < 0.0 || s.x >= Size.x || s.y >= Size.y {
		c = BG
	} else {
		c = imageSrc0At(s + imageSrc0Origin())
		if mod(floor(p.y), 2.0) >= 1.0 {
			c.rgb *= 1.0 - ScanlineStrength
		}
	}

	// Vignette: darken toward the corners (u.u = 2 at a corner).
	c.rgb *= 1.0 - Vignette*dot(u, u)*0.5

	// Rolling scan bar, 6% of the height, smooth falloff.
	cy := Size.y * fract(Time/max(ScanBarPeriod, 0.001))
	a := 1.0 - smoothstep(0.0, 0.03*Size.y, abs(p.y-cy))
	c.rgb += ScanBar * ScanBarStrength * a

	return vec4(c.rgb*mask, mask)
}
